{
  "name": "dake-stadio",
  "version": "0.2.0",
  "private": true,
  "description": "DAKE STADIO - integrated local image and vector creation",
  "author": "Yukihiko Kikuta",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:engine": "node scripts/check-engine.cjs",
    "test:app": "node scripts/run-app-check.cjs",
    "test:restart": "node scripts/run-restart-check.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "test:native": "node scripts/run-native-unit.cjs",
    "test:production": "node scripts/run-production-check.cjs",
    "test:pdf": "node scripts/run-native-pdf.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "fabric": "7.4.0",
    "opentype.js": "2.0.0",
    "paper": "0.12.18"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.4.5",
    "esbuild": "0.25.12"
  }
}
